# App
APP_ENV=development
LOG_LEVEL=INFO

# --- Security -----------------------------------------------------------------
# When set (non-empty), every /api/* route requires header `X-API-Key: <value>`;
# 401 otherwise. Leave empty to disable (local development).
# API_KEY=change-me-in-production
# Explicit CORS allowlist (comma-separated). Never use "*".
# BACKEND_ORIGINS=http://localhost:8501,http://localhost:3000

# --- Data & models ------------------------------------------------------------
# Telemetry CSV consumed by the API and dashboard.
# DATA_PATH=data/telemetry.csv
# Trained model bundle (joblib) produced by src/train.py.
# MODEL_PATH=models/pdm_bundle.joblib
